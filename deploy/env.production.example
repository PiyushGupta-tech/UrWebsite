DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
ALLOWED_HOSTS=urbanrupee.com,www.urbanrupee.com,185.199.53.121
SITE_BASE_URL=https://urbanrupee.com
# Optional — Google Search Console HTML tag verification token
# GSC_SITE_VERIFICATION=your-verification-token
# Optional — Google Analytics 4 Measurement ID; enables analytics and the cookie consent banner
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Urbanrupee admin payout micro-dashboard
ADMIN_DASHBOARD_USERNAME=
ADMIN_DASHBOARD_PASSWORD=
PAYOUT_DASHBOARD_API_URL=https://payout.urbanrupee.in/api/internal/payout-dashboard
INTERNAL_DASHBOARD_API_KEY=
PAYOUT_DASHBOARD_LATEST_LIMIT=100
PAYOUT_DASHBOARD_HTTP_TIMEOUT=10
PAYOUT_DASHBOARD_REFRESH_INTERVAL=10
PAYOUT_DASHBOARD_CACHE_TTL=30

# Payin internal API (merchant portal — Bearer token, server-side only)
PAYIN_DASHBOARD_API_URL=https://merchant.urbanrupee.in/api/internal/payin-dashboard
PAYIN_DASHBOARD_API_TOKEN=
PAYIN_DASHBOARD_LATEST_LIMIT=25
PAYIN_DASHBOARD_HTTP_TIMEOUT=10
PAYIN_DASHBOARD_REFRESH_INTERVAL=10
PAYIN_DASHBOARD_CACHE_TTL=30

# Redis cache for dashboard snapshots (dedicated DB + ACL user; see aaPanel Redis)
REDIS_URL=redis://urbanrupee:your-redis-password@127.0.0.1:6379/0

# Website chat assistant. Gemini is used when GEMINI_API_KEY is set, otherwise OpenAI when
# OPENAI_API_KEY is set; with neither, the bot answers from keyword FAQ matches only.
# Leads and "talk to a human" requests are emailed to CONTACT_EMAIL_TO (email_config.py).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is overloaded, rate limited, or retired. The free tier
# allows only about 20 requests a day per model, so enable billing on the Google project.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.7-flash
# GEMINI_REASONING_EFFORT=low
# GEMINI_TIMEOUT=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
# Optional limits (defaults shown)
# CHAT_RATE_LIMIT=20
# CHAT_RATE_WINDOW_SECONDS=60
# CHAT_AI_RATE_LIMIT=60
# CHAT_AI_RATE_WINDOW_SECONDS=3600
# CHAT_DAILY_AI_LIMIT=3000
# CHAT_MAX_USER_MESSAGES=40
# CHAT_LOG_RETENTION_DAYS=90

# Contact email recipient/SMTP settings live in backend/config/email_config.py.
# Only the Google app password for EMAIL_HOST_USER goes here; without it,
# contact messages are only printed to the gunicorn log.
EMAIL_HOST_PASSWORD=
